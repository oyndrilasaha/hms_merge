\f3\fs18 \cf2 \cb5 \strokec2 sequenceDiagram\cb1 \
\cb5     autonumber\cb1 \
\cb5     actor Rec as Receptionist\cb1 \
\cb5     actor Doc as Doctor\cb1 \
\cb5     actor Tech as Lab Tech\cb1 \
\cb5     actor Pharm as Pharmacist\cb1 \
\cb5     participant Sys as Node.js HTTP Server\cb1 \
\cb5     database DB as SQLite Database\cb1 \
\
\cb5     %% Stage 1: Auth\cb1 \
\cb5     Note over Rec, Sys: 1. Authentication Stage\cb1 \
\cb5     Rec->>Sys: POST /api/auth/login (username, password)\cb1 \
\cb5     Sys->>DB: Query user credentials & verify hash\cb1 \
\cb5     DB-->>Sys: Return user record (Role: Receptionist)\cb1 \
\cb5     Sys-->>Rec: 200 OK (Set-Cookie: sgh_session, CSRF token)\cb1 \
\
\cb5     %% Stage 2: Patient Registration\cb1 \
\cb5     Note over Rec, Sys: 2. Patient Registration Stage\cb1 \
\cb5     Rec->>Sys: POST /api/patients (demographics, contact) [With Session & CSRF]\cb1 \
\cb5     Sys->>Sys: Validate fields (names, phone, email format)\cb1 \
\cb5     Sys->>DB: INSERT INTO patients (global_number, demographics)\cb1 \
\cb5     DB-->>Sys: Confirm insert (patient_id: 3, MRN: SGH-000003)\cb1 \
\cb5     Sys->>DB: INSERT INTO audit_logs (PATIENT_CREATED)\cb1 \
\cb5     Sys-->>Rec: 201 Created (MRN: SGH-000003)\cb1 \
\
\cb5     %% Stage 3: Appointment Booking (Success & Conflict Check)\cb1 \
\cb5     Note over Rec, Sys: 3. Appointment Booking & Conflict Prevention\cb1 \
\cb5     Rec->>Sys: POST /api/appointments (patient_id: 3, doctor_id: 2, start: 14:00, end: 14:30)\cb1 \
\cb5     Sys->>DB: Query appointments for Doctor 2 between 14:00 and 14:30\cb1 \
\cb5     DB-->>Sys: Return 0 matching rows (No overlap)\cb1 \
\cb5     Sys->>DB: INSERT INTO appointments\cb1 \
\cb5     DB-->>Sys: Confirm insert (appointment_id: 45)\cb1 \
\cb5     Sys-->>Rec: 201 Created (Appointment scheduled)\cb1 \
\
\cb5     Rec->>Sys: POST /api/appointments (patient_id: 4, doctor_id: 2, start: 14:15, end: 14:45)\cb1 \
\cb5     Sys->>DB: Query appointments for Doctor 2 between 14:15 and 14:45\cb1 \
\cb5     DB-->>Sys: Return 1 matching row (appointment_id: 45 overlaps!)\cb1 \
\cb5     Sys-->>Rec: 409 Conflict (Doctor is busy)\cb1 \
\
\cb5     %% Stage 4: Clinical Consultation\cb1 \
\cb5     Note over Doc, Sys: 4. Clinical Note & Lab Order Stage\cb1 \
\cb5     Doc->>Sys: POST /api/clinical-notes (patient_id: 3, note: "Patient exhibits symptoms...")\cb1 \
\cb5     Sys->>DB: INSERT INTO medical_records\cb1 \
\cb5     DB-->>Sys: Confirm insert\cb1 \
\cb5     Sys-->>Doc: 201 Created (Note appended)\cb1 \
\
\cb5     Doc->>Sys: POST /api/lab-orders (patient_id: 3, test_type: "Blood Panel")\cb1 \
\cb5     Sys->>DB: INSERT INTO lab_orders (status: PENDING)\cb1 \
\cb5     DB-->>Sys: Confirm insert (order_id: 12)\cb1 \
\cb5     Sys-->>Doc: 201 Created (Lab order placed)\cb1 \
\
\cb5     %% Stage 5: Lab Execution\cb1 \
\cb5     Note over Tech, Sys: 5. Lab Results Entry Stage\cb1 \
\cb5     Tech->>Sys: PATCH /api/lab-orders/12 (result: "Normal", status: COMPLETED)\cb1 \
\cb5     Sys->>DB: UPDATE lab_orders SET status = COMPLETED, INSERT INTO lab_results\cb1 \
\cb5     DB-->>Sys: Confirm updates\cb1 \
\cb5     Sys-->>Tech: 200 OK (Results recorded)\cb1 \
\
\cb5     %% Stage 6: Pharmacy Dispensing\cb1 \
\cb5     Note over Pharm, Sys: 6. Medication Dispense Stage\cb1 \
\cb5     Pharm->>Sys: POST /api/medications/dispense (patient_id: 3, medicine_id: 5, qty: 2)\cb1 \
\cb5     Sys->>DB: Query inventory balance for Medicine 5 (Batch A)\cb1 \
\cb5     DB-->>Sys: Return stock: 10, expiry: 2028-12-31\cb1 \
\cb5     Sys->>DB: UPDATE inventory (stock - 2) & INSERT INTO inventory_transactions\cb1 \
\cb5     DB-->>Sys: Confirm update\cb1 \
\cb5     Sys-->>Pharm: 200 OK (Dispensing recorded, stock updated)\cb1 \
\
\cb5     %% Stage 7: Invoicing\cb1 \
\cb5     Note over Rec, Sys: 7. Billing Stage\cb1 \
\cb5     Rec->>Sys: PATCH /api/invoices/99 (status: PAID)\cb1 \
\cb5     Sys->>DB: UPDATE invoices SET status = PAID, INSERT INTO payments\cb1 \
\cb5     DB-->>Sys: Confirm update\cb1 \
\cb5     Sys-->>Rec: 200 OK (Payment confirmed)\cb1 \
\pard\pardeftab720\partightenfactor0

