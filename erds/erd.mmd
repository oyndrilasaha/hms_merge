    class Invoice {
        +int invoice_id
        +int patient_id
        +string visit_ref
        +decimal total
        +string status
        +datetime issued_at
        +calculateTotal() decimal
        +issueInvoice() bool
        +updatePaymentStatus() bool
    }

    class AuditLog {
        +int audit_id
        +string actor
        +string role
        +string action
        +string object_type_id
        +string outcome
        +datetime timestamp
        +string source
        +writeEntry() bool
        +readLogs() List
    }

    Staff <|-- Doctor : Inherits
