    class Appointment {
        +int appointment_id
        +int patient_id
        +int doctor_staff_id
        +int branch_id
        +datetime start_time
        +datetime end_time
        +string status
        +string reason
        +create() bool
        +checkConflict() bool
        +cancel() bool
    }

    class MedicalRecord {
        +int record_id
        +int patient_id
        +int author_staff_id
