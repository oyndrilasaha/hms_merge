        +logout() bool
        +verifySession() bool
    }

    class Patient {
        +int patient_id
        +int user_id
        +string global_number
        +string demographics
        +string contact
        +register() Patient
        +getHistory() List
        +updateContact() bool
    }

    class Staff {
        +int staff_id
        +int user_id
        +int branch_id
        +string profession
        +string registration_no
        +string status
        +getSchedule() List
        +updateStatus() bool
    }

    class Doctor {
        +addNote(patient_id, content) bool
        +orderLab(patient_id, test_type) LabOrder
        +viewPatientNotes(patient_id) List
